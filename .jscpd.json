{
  "threshold": 7,
  "reporters": ["console", "html"],
  "ignore": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/src/errors/handleErrors.ts",
    "**/src/errors/handleErrorsWithRecovery.ts",
    "**/src/errors/retryOnError.ts"
  ],
  "absolute": true,
  "gitignore": true,
  "output": "./reports/jscpd/",
  "formats": ["typescript", "javascript"],
  "minLines": 5,
  "maxLines": 500,
  "minTokens": 25,
  "maxSize": "30kb"
}
